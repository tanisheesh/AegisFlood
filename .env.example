# Optional server-side defaults for live Telegram emergency alert broadcasts (/api/telegram)
# Operators can also supply ephemeral credentials directly in the /playground UI
TELEGRAM_BOT_TOKEN=   # Optional: Telegram Bot Token from @BotFather (/newbot)
TELEGRAM_CHAT_ID=     # Optional: Target Telegram user, group, or channel ID
NEXT_PUBLIC_SITE_URL= # Optional: Canonical site origin (defaults to https://aegisflood.tanisheesh.in)
